# ES2-KING 人物管理 V0 增量映像：只疊加管理命令，不重建 Original ES2／整個遊戲。
ARG BASE_IMAGE=es2-king:oracle
FROM ${BASE_IMAGE}
ARG CHARACTER_ADMIN_COMMIT=unknown
USER root

# 僅更新人物管理系統 V0 的三個 daemon 與十二個管理命令；保留既有遊戲 Runtime 和玩家存檔。
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/adm/daemons/kingd.c /opt/es2-king/runtime/mudlib/adm/daemons/kingd.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/adm/daemons/kadmind.c /opt/es2-king/runtime/mudlib/adm/daemons/kadmind.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/adm/daemons/kcharadmind.c /opt/es2-king/runtime/mudlib/adm/daemons/kcharadmind.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kaudit.c /opt/es2-king/runtime/mudlib/cmds/adm/kaudit.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kadmin.c /opt/es2-king/runtime/mudlib/cmds/adm/kadmin.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kclass.c /opt/es2-king/runtime/mudlib/cmds/adm/kclass.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kexp.c /opt/es2-king/runtime/mudlib/cmds/adm/kexp.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/khelp.c /opt/es2-king/runtime/mudlib/cmds/adm/khelp.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kinfo.c /opt/es2-king/runtime/mudlib/cmds/adm/kinfo.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kitem.c /opt/es2-king/runtime/mudlib/cmds/adm/kitem.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/klocate.c /opt/es2-king/runtime/mudlib/cmds/adm/klocate.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kmoney.c /opt/es2-king/runtime/mudlib/cmds/adm/kmoney.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/ksave.c /opt/es2-king/runtime/mudlib/cmds/adm/ksave.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kset.c /opt/es2-king/runtime/mudlib/cmds/adm/kset.c
COPY --chown=10001:10001 es2_king_expansion/runtime/mudlib/cmds/adm/kskill.c /opt/es2-king/runtime/mudlib/cmds/adm/kskill.c

# Build label／版本標籤：保留完整遊戲映像版本，另外記錄人物管理層版本。
LABEL org.es2king.character-admin.commit="${CHARACTER_ADMIN_COMMIT}"
USER es2king
